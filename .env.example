# Copy to .env to override defaults. No API keys are needed: all sources are free and public.

# Where bronze Parquet files and DuckDB warehouses live (default: ./data)
# CMDP_DATA_DIR=./data

# Source API base URLs
# CMDP_VALET_BASE_URL=https://www.bankofcanada.ca/valet
# CMDP_STATCAN_BASE_URL=https://www150.statcan.gc.ca/t1/wds/rest

# Comma-separated origins allowed to call the API
# CMDP_CORS_ORIGINS=http://localhost:3000

# Frontend: where the browser finds the API
NEXT_PUBLIC_API_URL=http://localhost:8000
